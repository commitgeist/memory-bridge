{
  "name": "memory-bridge",
  "version": "0.1.0",
  "description": "Versioned, neutral project memory shared across agent harnesses.",
  "license": "MIT",
  "author": "Commitgeist",
  "type": "module",
  "bin": { "memory-bridge": "dist/cli.js" },
